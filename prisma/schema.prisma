// Prisma schema for QuoteForge
// Built by ZAInnovate Technologies (Pty) Ltd
// Enterprise-grade SaaS for South African SMMEs & Tenderers

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentType {
  QUOTE
  INVOICE
  DELIVERY_NOTE
  PURCHASE_ORDER
}

enum DocumentStatus {
  DRAFT
  SENT
  ACCEPTED
  PAID
  OVERDUE
  CANCELLED
}

enum SubscriptionPlan {
  FREE
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  companyId     String?
  company       Company?       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription  Subscription?
  documents     Document[]
}

model Company {
  id              String      @id @default(cuid())
  name            String
  tradingName     String?
  regNumber       String?     // CIPC Registration e.g. 2024/098765/07
  vatNumber       String?     // SARS VAT (10 digits starting with 4)
  taxNumber       String?     // SARS Income Tax Number
  taxPin          String?     // SARS TCS (Tax Compliance Status) PIN
  csdNumber       String?     // National Treasury Central Supplier Database (e.g. MAAA1234567)
  bbbeeLevel      String?     @default("Level 1 Contributor (100% Black Youth Owned)")
  
  address         String?
  city            String?
  province        String?     // Eastern Cape, Gauteng, Western Cape, etc.
  postalCode      String?
  phone           String?
  email           String?
  website         String?
  logo            String?     // URL or base64
  
  // Banking Details (Essential for SA Invoices & Tender Proof)
  bankName        String?     // FNB, Standard Bank, Capitec, Nedbank, ABSA, Investec
  accountHolder   String?
  accountNumber   String?
  branchCode      String?     // 6-digit universal branch code
  accountType     String?     // Cheque / Current / Savings

  // Preferences & Defaults
  currency        String      @default("ZAR")
  defaultVatRate  Float       @default(15.0)
  quotePrefix     String      @default("QT-")
  invoicePrefix   String      @default("INV-")
  poPrefix        String      @default("PO-")
  dnPrefix        String      @default("DN-")
  nextQuoteNum    Int         @default(1001)
  nextInvoiceNum  Int         @default(1001)
  defaultNotes    String?
  defaultTerms    String?     // e.g. Payment strictly within 30 days.

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  users           User[]
  clients         Client[]
  documents       Document[]
}

model Client {
  id          String      @id @default(cuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  name        String      // Contact person or company name
  companyName String?
  email       String
  phone       String?
  address     String?
  city        String?
  province    String?
  postalCode  String?
  vatNumber   String?     // SARS VAT number for business clients
  csdNumber   String?     // Client CSD number if Government / Parastatal client

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  documents   Document[]

  @@index([companyId])
}

model Document {
  id              String          @id @default(cuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  clientId        String
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)

  type            DocumentType    @default(QUOTE)
  status          DocumentStatus  @default(DRAFT)
  number          String          // e.g. INV-2026-1001
  referenceNumber String?         // Client Purchase Order (PO) or Tender Reference
  date            DateTime        @default(now())
  dueDate         DateTime?
  supplyDate      DateTime?       // SARS Tax Invoice Date of Supply

  subtotal        Float           @default(0.0)
  vatAmount       Float           @default(0.0)
  discount        Float           @default(0.0)
  total           Float           @default(0.0)
  amountPaid      Float           @default(0.0)
  balanceDue      Float           @default(0.0)

  notes           String?
  terms           String?
  footerText      String?

  sentAt          DateTime?
  paidAt          DateTime?
  pdfUrl          String?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  items           LineItem[]
  payments        PaymentRecord[]

  @@unique([companyId, number])
  @@index([companyId, type])
  @@index([companyId, status])
}

model LineItem {
  id          String    @id @default(cuid())
  documentId  String
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  position    Int       @default(0)
  description String
  quantity    Float     @default(1.0)
  unitPrice   Float     @default(0.0)
  vatRate     Float     @default(15.0) // 15% standard, 0% zero-rated/exempt
  subtotal    Float     @default(0.0)
  vatAmount   Float     @default(0.0)
  total       Float     @default(0.0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([documentId])
}

model Subscription {
  id                    String              @id @default(cuid())
  userId                String              @unique
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan                  SubscriptionPlan    @default(FREE)
  status                SubscriptionStatus  @default(ACTIVE)

  // Paystack Integration Fields
  paystackCustomerId    String?
  paystackSubscriptionCode String?
  paystackEmailToken    String?
  paystackPlanCode      String?
  paystackAuthCode      String?             // Reusable authorization code for card charges

  currentPeriodStart    DateTime            @default(now())
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean             @default(false)

  // Usage limits tracking
  documentsThisMonth    Int                 @default(0)
  lastUsageReset        DateTime            @default(now())

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

model PaymentRecord {
  id            String    @id @default(cuid())
  documentId    String
  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  amount        Float
  paymentDate   DateTime  @default(now())
  method        String    // EFT, Paystack, Cash, Card, SnapScan
  reference     String?
  notes         String?
  
  // Paystack transaction reference
  paystackRef   String?   @unique

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([documentId])
}
